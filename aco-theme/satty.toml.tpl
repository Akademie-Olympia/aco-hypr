# Generated by aco-theme from ~/.config/hypr/aco-theme/satty.toml.tpl. Do not edit.
# Loaded explicitly by screenshot.sh; independent of other Satty profiles.
[general]
initial-tool = "arrow"
copy-command = "wl-copy --type image/png"
save-after-copy = true
early-exit = ["all"]
actions-on-enter = ["save-to-clipboard"]
actions-on-escape = ["exit"]
corner-roundness = {{radius}}
default-hide-toolbars = false
no-window-decoration = true

[font]
family = "{{ui_font}}"
style = "Regular"

# The desktop palette; the numbers 1-8 select the colour.
[color-palette]
palette = ["{{red}}", "{{orange}}", "{{yellow}}", "{{green}}", "{{cyan}}", "{{blue}}", "{{purple}}", "{{text}}"]
