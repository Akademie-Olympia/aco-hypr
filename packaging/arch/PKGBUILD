# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=aco-arch-dotfiles-hypr
pkgver=0.3.0
pkgrel=1
pkgdesc='Hyprland desktop, screenshot and window helpers'
arch=('any')
url='https://github.com/Akademie-Olympia/aco-arch-dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('aco-arch-dotfiles-core>=0.3.0' 'aco-arch-dotfiles-aco-theme' 'hyprland>=0.56.0' 'hyprlock' 'hypridle' 'xdg-desktop-portal-hyprland' 'wl-clipboard' 'grim' 'slurp' 'satty' 'brightnessctl' 'jq' 'util-linux' 'procps-ng' 'sudo' 'aco-arch-dotfiles-kitty' 'aco-arch-dotfiles-rofi' 'aco-arch-dotfiles-waybar' 'aco-arch-dotfiles-swaync' 'aco-arch-dotfiles-wallpaper' 'aco-arch-dotfiles-tmux' 'aco-arch-dotfiles-yazi' 'aco-arch-dotfiles-qt6ct' 'aco-arch-dotfiles-settings' 'dolphin' 'kio-extras' 'ffmpegthumbs' 'ark' 'xdg-utils' 'psmisc' 'wireplumber' 'xdg-desktop-portal-gtk')
optdepends=('firefox: web browser (aco install browser)' 'pciutils: GPU, network and audio drivers in Einstellungen > System' 'bluez-utils: Bluetooth page in the settings' 'pavucontrol: mixer from the sound page' 'ffmpeg: camera preview (ffplay) in Einstellungen > Kamera')
replaces=('arch-dotfiles-hypr')
conflicts=('arch-dotfiles-hypr')
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
